{
  "name": "outlook-mcp",
  "version": "1.0.0",
  "description": "Outlook Web MCP Server via Playwright/CDP Browser Bridge",
  "type": "module",
  "main": "index.js",
  "bin": {
    "outlook-mcp": "./index.js"
  },
  "files": [
    "index.js",
    "src/"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
